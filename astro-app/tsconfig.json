{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "verbatimModuleSyntax": false,
        "skipLibCheck": true,
        "paths": {
            "react": ["./node_modules/@types/react"],
            "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"],
            "@/*": ["./src/*"],
            "@shared/domain/*": ["../src/domain/*"],
            "@shared/data/*": ["../src/data/*"],
            "@shared/types/*": ["../src/types/*"],
            "@shared/utils/*": ["../src/utils/*"],
            "@shared/CompositionRoot": ["../src/CompositionRoot"],
            "@shared/webapp/*": ["../src/webapp/*"]
        }
    },
    "include": [
        ".astro/types.d.ts",
        "src/**/*",
        "../src/domain/**/*",
        "../src/data/**/*",
        "../src/types/**/*",
        "../src/utils/**/*",
        "../src/CompositionRoot.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "../src/**/__tests__/**",
        "../src/**/*.spec.*",
        "../src/**/*.test.*",
        "../src/utils/tests-ui.tsx",
        "../src/data/export/**",
        "../src/data/repositories/PersonD2Repository.ts"
    ]
}
