DHIS2_BASE_URL=https://dev.eyeseetea.com/play
# Vite expands $VAR / ${VAR} in .env values even inside quotes — escape literal `$` as `\$`.
DHIS2_AUTH=admin:district

# Path prefix the site is served under. Leave as "/" for root deployments.
# Examples: "/UHCW" for subpath deploys, "/preview/pr-123" for preview branches.
ASTRO_BASE_PATH=/
