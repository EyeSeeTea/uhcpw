DHIS2_BASE_URL=https://dev.eyeseetea.com/play
# Vite expands $VAR / ${VAR} in .env values even inside quotes — escape literal `$` as `\$`.
DHIS2_AUTH=admin:district

# Canonical public URL used by Astro for generated absolute URLs.
# Defaults to https://apps.who.int/dhis2/uhcwatch when omitted.
SITE_URL=http://localhost:4321

# Public Mapbox token used by the client-side React map island.
PUBLIC_MAPBOX_TOKEN=your_token

# Path prefix the site is served under. Leave as "/" for root deployments.
# Examples: "/UHCW" for subpath deploys, "/preview/pr-123" for preview branches.
ASTRO_BASE_PATH=/

# Optional logging controls.
LOG_LEVEL=info
LOG_PRETTY=true
