---
import Layout from "@/layouts/Layout.astro";
import { getSeoConfigForAstroRoute } from "@/lib/seo";
import PageBanner from "@/components/layout/PageBanner.astro";
import { ScrollToTopButton } from "@shared/webapp/components/scroll-to-top-button/ScrollToTopButton";
import { getAbbreviationsPageData } from "@/data/reference-terms/reference-terms-data";
import { getGeneralContent } from "@/data/general-content";
import { buildAbbreviationGroups } from "@/data/reference-terms/reference-terms-view";
import "@/styles/reference-terms.css";

const [{ entries, categories }, generalContent] = await Promise.all([getAbbreviationsPageData(), getGeneralContent()]);
const groups = buildAbbreviationGroups({ entries, categories });
---
<Layout generalContent={generalContent} seo={getSeoConfigForAstroRoute(Astro.url.pathname)}>
    <PageBanner title="Abbreviations" />
    <div class="reference-content" data-reference-page="abbreviations">
        <div class="reference-controls" hidden>
            <div class="reference-search">
                <label for="reference-query">Search abbreviations and meanings</label>
                <input id="reference-query" type="search" placeholder="Try UHC, Germany or French" autocomplete="off" />
            </div>
            <button type="button" class="reference-button" data-reset hidden>Clear search</button>
        </div>
        <nav class="reference-group-nav" aria-label="Jump to category">
            {groups.map(group => <a href={`#${group.id}`} data-group-link>{group.name}</a>)}
        </nav>
        <p data-empty role="status" hidden>No abbreviations found. Try another search or clear the search.</p>
        {groups.map(group => (
            <section class="abbreviation-group" id={group.id} data-group>
                <h2>{group.name}</h2>
                <dl class="abbreviation-list">
                    {group.entries.map(entry => (
                        <div class="abbreviation-row" id={entry.id} data-entry data-search={`${entry.abbreviation} ${entry.meaning}`}><dt><a href={`#${entry.id}`} aria-label={`Link to ${entry.abbreviation}`}>{entry.abbreviation}</a></dt><dd>{entry.meaning}</dd></div>
                    ))}
                </dl>
            </section>
        ))}
        {entries.length === 0 && <p>No abbreviations available.</p>}
        <a class="back-to-top" href="#">Back to top ↑</a>
        <div class="mobile-back-to-top"><ScrollToTopButton client:only="react" threshold={0} /></div>
    </div>
</Layout>
<script>import { initReferencePage } from "@/scripts/reference-terms/reference-terms-client"; initReferencePage("abbreviations");</script>
