---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { getServerCompositionRoot } from "@/infra/composition-root.server";
import { runFuture } from "@/infra/future-bridge";
import { renderMarkdown } from "@/lib/markdown";
import { getSeoConfigForRoute } from "@shared/domain/entities/SeoConfig";
import bubblePattern from "@/assets/bubble-pattern-white.png";

const compositionRoot = getServerCompositionRoot();

const [methods, generalContent] = await Promise.all([
    runFuture(compositionRoot.method.get.execute()),
    runFuture(compositionRoot.general.getContent.execute()),
]);

const seo = getSeoConfigForRoute(Astro.url.pathname);

const abbreviationsUrl = (generalContent.abbreviations.url ?? "https://cmyn.short.gy/abbreviations").replace(/([^:])\/\/+/g, "$1/");
const glossaryUrl = (generalContent.glossary.url ?? "https://cmyn.short.gy/glossary").replace(/([^:])\/\/+/g, "$1/");

const gridRows = Math.ceil(methods.length / 2);
---

<Layout seo={seo} generalContent={generalContent}>
    <div class="title-banner" aria-label="methods-page-header">
        <Image
            class="bubble-img"
            src={bubblePattern}
            alt=""
            aria-hidden="true"
            loading="eager"
        />
        <h3>Methods</h3>
    </div>

    <div class="main-content">
        <div class="methods-grid" style={`--grid-rows: ${gridRows}`} aria-label="methods-container">
            {methods.map((method) => (
                <div class="method-item" aria-label="method-item">
                    <h5>{method.sectionName}</h5>

                    <div class="text-container">
                        <div class="markdown-content" set:html={renderMarkdown(method.shortText)} />

                        <details>
                            <summary>
                                <span class="label-read-more">Read more<span class="chevron" aria-hidden="true">&#x25BE;</span></span>
                                <span class="label-read-less">Read less<span class="chevron" aria-hidden="true">&#x25B4;</span></span>
                            </summary>
                            <div class="markdown-content" set:html={renderMarkdown(method.text)} />
                        </details>
                    </div>
                </div>
            ))}

            <div class="download-links" aria-label="methods-buttons">
                <a class="download-link" href={abbreviationsUrl} target="_blank" rel="noreferrer">Abbreviations</a>
                <a class="download-link" href={glossaryUrl} target="_blank" rel="noreferrer">Glossary</a>
            </div>
        </div>
    </div>
</Layout>

<style>
    /* ── Title Banner ─────────────────────────────────────────────────────── */

    .title-banner {
        background-color: var(--color-accent-primary);
        color: white;
        padding: 24px 200px 24px 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    .title-banner h3 {
        margin: 0;
        font-size: 3rem;
        font-weight: 400;
        z-index: 1;
    }

    .bubble-img {
        position: absolute;
        top: 0;
        right: 0;
        width: auto;
        height: auto;
        max-width: none;
        pointer-events: none;
        opacity: 0.9;
    }

    @media (max-width: 600px) {
        .title-banner {
            background: url("/assets/map-background.jpg") center / cover;
            padding: 24px 40px;
        }

        .bubble-img {
            display: none;
        }
    }

    /* ── Main Content ─────────────────────────────────────────────────────── */

    .main-content {
        padding: 80px 64px;
    }

    @media (max-width: 600px) {
        .main-content {
            padding: 40px;
        }
    }

    /* ── Methods Grid ─────────────────────────────────────────────────────── */

    .methods-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(var(--grid-rows), auto);
        grid-auto-flow: column;
        gap: 40px;
    }

    @media (max-width: 600px) {
        .methods-grid {
            grid-template-columns: 1fr;
            grid-auto-flow: row;
        }
    }

    /* ── Method Item ──────────────────────────────────────────────────────── */

    .method-item h5 {
        margin: 0 0 10px 0;
        font-size: 1.5rem;
        font-weight: 400;
    }

    .text-container {
        width: 95%;
    }

    /* ── Markdown Typography ──────────────────────────────────────────────── */

    .markdown-content :global(p) {
        font-size: var(--font-size-sm);
        line-height: 1.5;
        margin: 0 0 10px 0;
    }

    .markdown-content :global(ul) {
        padding-left: 1.2em;
        margin: 0 0 10px 0;
    }

    .markdown-content :global(li) {
        font-size: var(--font-size-sm);
        line-height: 1.75;
    }

    .markdown-content :global(a) {
        color: var(--color-accent-primary);
        text-decoration: none;
        padding: 0 3px;
    }

    .markdown-content :global(a:hover) {
        text-decoration: underline;
    }

    /* ── Expand / Collapse ────────────────────────────────────────────────── */

    details {
        border: none;
    }

    summary {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        color: var(--color-accent-primary);
        font-weight: 700;
        font-size: var(--font-size-sm);
        list-style: none;
        padding: 0;
        margin: 0;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::marker {
        content: "";
    }

    .chevron {
        margin-inline-start: 4px;
        position: relative;
        bottom: 1px;
        font-size: 1em;
    }

    /* Default (closed): show "Read more", hide "Read less" */
    .label-read-more {
        display: inline-flex;
        align-items: center;
    }
    .label-read-less {
        display: none;
    }

    /* Open: show "Read less", hide "Read more" */
    details[open] .label-read-more {
        display: none;
    }
    details[open] .label-read-less {
        display: inline-flex;
        align-items: center;
    }

    /* ── Download Links ───────────────────────────────────────────────────── */

    .download-links {
        display: flex;
        gap: 20px;
        height: max-content;
    }

    .download-link {
        border-radius: 20px;
        color: white;
        background-color: var(--color-accent-primary);
        text-decoration: none;
        font-size: 14px;
        line-height: 2;
        padding: 5px 15px;
        text-align: center;
    }

    .download-link:hover {
        opacity: 0.5;
    }
</style>
