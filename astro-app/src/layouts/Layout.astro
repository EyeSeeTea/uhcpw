---
import type { SeoConfig } from "@shared/domain/entities/SeoConfig";
import type { GeneralContent } from "@shared/domain/entities/GeneralContent";
import { defaultSeoConfig } from "@shared/domain/entities/SeoConfig";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import SeoHead from "@/components/seo/SeoHead.astro";
import { resolveGeneralContentUrls } from "@/data/general-content";
import "@/styles/theme.css";

interface Props {
    seo?: SeoConfig;
    generalContent?: GeneralContent;
}

const { seo = defaultSeoConfig, generalContent } = Astro.props;

const { abbreviationsUrl, glossaryUrl } = resolveGeneralContentUrls(generalContent);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <SeoHead seo={seo} />
    </head>
    <body>
        <Header
            abbreviationsUrl={abbreviationsUrl}
            glossaryUrl={glossaryUrl}
        />
        <main>
            <slot />
        </main>
        <Footer
            disclaimer={generalContent?.footer.disclaimer}
            privacyPolicyUrl={generalContent?.cookies.policyUrl}
            abbreviationsUrl={abbreviationsUrl}
            glossaryUrl={glossaryUrl}
        />
    </body>
</html>

<style>
    main {
        min-height: 100vh;
        overflow: hidden;
        background: var(--color-white);
    }

    @media (max-width: 600px) {
        main {
            min-height: 0;
        }
    }
</style>
