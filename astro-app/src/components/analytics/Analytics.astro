---
// Google Analytics 4 loader. Tag IDs mirror the React SPA. Selection happens
// at build time via `getAnalyticsTagId()`. Render this component once inside
// the `<head>` of the base layout — it must run before the first paint and
// before any React island hydrates.
import { getAnalyticsTagId } from "@/infra/analytics.config";

const gaTagId = getAnalyticsTagId();
---

<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaTagId}`}></script>
<script is:inline define:vars={{ gaTagId }}>
    // Canonical Google Analytics 4 bootstrap snippet. `window.gtag` must push
    // the `arguments` object (not a rest-params array) — gtag.js processes the
    // dataLayer queue by calling `gtag.apply(null, item)` and expects each
    // `item` to be the Arguments-shaped record produced by `push(arguments)`.
    // Replacing this with `function (...args) { dataLayer.push(args); }` looks
    // equivalent but prevents events from reaching `/g/collect`.
    window.dataLayer = window.dataLayer || [];
    // eslint-disable-next-line prefer-rest-params
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag("js", new Date());
    // Staff and contributors can opt out by visiting `/internal-on`, which sets
    // `localStorage.uhcpw_internal = "1"`. When set, we tag the config with
    // `traffic_type: "internal"` so GA4's Internal Traffic Data Filter can
    // exclude these events. `/internal-off` clears the flag.
    let uhcpwIsInternal;
    try {
        uhcpwIsInternal = localStorage.getItem("uhcpw_internal") === "1";
    } catch {
        uhcpwIsInternal = false;
    }
    if (uhcpwIsInternal) window.gtag("config", gaTagId, { traffic_type: "internal" });
    else window.gtag("config", gaTagId);
</script>
