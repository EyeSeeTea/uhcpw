---
const isHomePage = Astro.url.pathname === "/";

const navItems = [
    { label: "Indicator explorer", href: "/indicator-explorer" },
    { label: "Policy explorer", href: "/policy-explorer" },
    { label: "Regional overview", href: "/regional-overview" },
    { label: "Countries & areas", href: "/countries" },
    { label: "Methods", href: "/methods" },
    { label: "Resources", href: "/resources" },
    { label: "About us", href: "/about" },
];
---

<div class="mobile-nav-wrapper">
    <details class="mobile-nav" id="mobile-nav">
        <summary class="menu-toggle" aria-label="Toggle navigation menu">
            <svg class="icon-menu" viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
            </svg>
            <svg class="icon-close" viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
            </svg>
        </summary>
        <nav class="menu-dropdown" aria-label="Mobile navigation">
            {!isHomePage && (
                <a href="/" class="menu-link menu-link--home" aria-label="Home">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                    </svg>
                </a>
            )}
            {navItems.map((item, i) => (
                <>
                    {(i > 0 || !isHomePage) && <hr class="menu-divider" />}
                    <a href={item.href} class="menu-link">{item.label}</a>
                </>
            ))}
        </nav>
    </details>
</div>

<style>
    .mobile-nav-wrapper {
        display: none;
        position: relative;
    }

    @media (max-width: 960px) {
        .mobile-nav-wrapper {
            display: block;
        }
    }

    .mobile-nav {
        position: relative;
    }

    .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        list-style: none;
        padding: 8px;
        border-radius: 4px;
    }

    .menu-toggle::-webkit-details-marker {
        display: none;
    }

    .menu-toggle {
        color: var(--color-grey-black);
    }

    .menu-toggle:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .icon-close {
        display: none;
    }

    .mobile-nav[open] .icon-menu {
        display: none;
    }

    .mobile-nav[open] .icon-close {
        display: block;
    }

    .menu-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        background: var(--color-accent-primary);
        color: white;
        border: 1px solid #d3d4d5;
        padding: 10px;
        z-index: 100;
        min-width: 200px;
        display: flex;
        flex-direction: column;
    }

    .menu-link {
        display: block;
        padding: 10px 16px;
        color: white;
        text-decoration: none;
        font-size: var(--font-size-sm);
        font-weight: 500;
        line-height: 1.75;
        border-radius: 4px;
    }

    .menu-link--home {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
    }

    .menu-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .menu-divider {
        margin: 7px auto;
        width: 80%;
        border: none;
        border-top: 1px solid #b5b5b5;
    }
</style>

<script>
    const nav = document.getElementById("mobile-nav") as HTMLDetailsElement | null;
    if (nav) {
        document.addEventListener("click", (e) => {
            if (nav.open && !nav.contains(e.target as Node)) {
                nav.open = false;
            }
        });

        nav.querySelectorAll(".menu-link").forEach((link) => {
            link.addEventListener("click", () => {
                nav.open = false;
            });
        });
    }
</script>
