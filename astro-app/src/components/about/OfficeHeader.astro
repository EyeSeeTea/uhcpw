---
import { renderMarkdown } from "../../lib/markdown";

interface Props {
    officeImage: string;
    officeVideo: string;
    officeText: string;
}

const { officeImage, officeVideo, officeText } = Astro.props;

const textHtml = renderMarkdown(officeText);
---

<section class="office-header" aria-label="WHO Barcelona Office">
    <div class="office-grid">
        <div class="image-column">
            <a href={officeVideo} target="_blank" rel="noreferrer">
                <img
                    src={officeImage}
                    alt="WHO Barcelona Office"
                    width="100%"
                    style="padding-block-start: 16px;"
                    loading="lazy"
                />
            </a>
            <p class="caption">WHO Barcelona Office for Health Systems Financing</p>
        </div>

        <div class="text-column">
            <div class="text-content" set:html={textHtml} />
        </div>
    </div>
</section>

<style>
    .office-header {
        color: var(--color-white);
    }

    .office-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
        padding: 32px;
    }

    .image-column a {
        display: block;
    }

    .caption {
        font-weight: 300;
        margin-top: 20px;
        margin-bottom: 0;
        font-family: var(--font-family-base);
        font-size: var(--font-size-base);
    }

    .text-column {
        display: flex;
        align-items: flex-start;
    }

    .text-content {
        max-width: 600px;
        font-family: var(--font-family-base);
    }

    .text-content :global(p) {
        font-weight: 300;
        margin-block-start: 1em;
        margin-block-end: 1em;
        font-size: var(--font-size-base);
        line-height: 1.5;
    }

    @media (max-width: 959px) {
        .office-grid {
            grid-template-columns: 1fr;
        }

        .text-content {
            max-width: 100%;
        }
    }
</style>
