---
import { YouTube } from "@astro-community/astro-embed-youtube";
import { renderMarkdown } from "@/lib/markdown";
import { href } from "@/lib/href";
import { getYouTubeEmbedUrl } from "@shared/domain/entities/YouTubeVideo";

interface Props {
    officeImage: string;
    officeImageWidth: number;
    officeImageHeight: number;
    officeVideo: string;
    officeText: string;
}

const { officeImage, officeImageWidth, officeVideo, officeText } = Astro.props;

const textHtml = renderMarkdown(officeText);
const caption = "WHO Barcelona Office for Health Systems Financing";
const videoEmbedUrl = getYouTubeEmbedUrl(officeVideo);
---

<section class="office-header" aria-label="WHO Barcelona Office">
    <div class="office-grid">
        <div class="image-column">
            <a
                id="office-video-link"
                href={officeVideo}
                target="_blank"
                rel="noreferrer"
                data-youtube-embed={videoEmbedUrl}
                data-youtube-title={caption}
            >
                <img
                    src={href(officeImage)}
                    alt="WHO Barcelona Office"
                    class="office-image"
                    width={officeImageWidth}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </a>
            {
                videoEmbedUrl && (
                    <template id="office-video-tpl">
                        <div class="office-video">
                            <YouTube id={videoEmbedUrl} title={caption} />
                        </div>
                    </template>
                )
            }
            <script>
                // On mobile the office video plays embedded instead of behind the image link. Gate render
                // so the YouTube facade (lite-youtube) is never connected to the DOM on desktop.
                const tpl = document.getElementById("office-video-tpl");
                const link = document.getElementById("office-video-link");
                if (tpl instanceof HTMLTemplateElement && link && window.matchMedia("(max-width: 959px)").matches) {
                    link.replaceWith(tpl.content.cloneNode(true));
                }
            </script>
            <p class="caption">{caption}</p>
        </div>

        <div class="text-column">
            <div class="text-content" set:html={textHtml} />
        </div>
    </div>
</section>

<style>
    .office-header {
        color: var(--color-white);
    }

    .office-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: flex-start;
        padding: 32px 12px;
        margin-bottom: -20px;
    }

    .image-column,
    .text-column {
        padding: 20px;
    }

    .image-column a {
        display: block;
    }

    .office-image {
        width: 100%;
        height: auto;
        padding-block-start: 16px;
    }

    .office-video {
        padding-block-start: 16px;
    }

    .office-video :global(lite-youtube) {
        width: 100%;
        max-width: 100%;
    }

    .caption {
        font-weight: 300;
        margin-top: 25px;
        margin-bottom: 0;
        font-family: var(--font-family-base);
        font-size: var(--font-size-base);
    }

    .text-column {
        display: flex;
        align-items: flex-start;
    }

    .text-content {
        max-width: 600px;
        padding-inline: 24px;
        margin: 0 auto;
        font-family: var(--font-family-base);
    }

    .text-content :global(p) {
        font-weight: 300;
        margin-block-start: 1em;
        margin-block-end: 1em;
        font-size: var(--font-size-base);
        line-height: 1.5;
    }

    @media (max-width: 959px) {
        .office-grid {
            grid-template-columns: 1fr;
        }

        .text-content {
            max-width: 100%;
        }
    }

    @media (max-width: 599px) {
        .text-content {
            padding-inline: 16px;
        }
    }
</style>
