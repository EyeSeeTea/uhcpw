---
import type { SeoConfig } from "@shared/domain/entities/SeoConfig";
import uhcwPng from "@/assets/uhcw.png?url";

interface Props {
    seo: SeoConfig;
}

const { seo } = Astro.props;

// `Astro.url.pathname` already includes the configured `base`, so resolving it
// as an absolute URL against `Astro.site` drops any path portion of `site` (per
// the URL constructor when the first arg is absolute). This is correct only
// when `SITE_URL` and `ASTRO_BASE_PATH` are kept consistent: either both include
// the subpath (e.g. site=https://host/UHCW, base=/UHCW) or neither does
// (site=https://host, base=/). Mixing them — e.g. site with a path while
// base=/ — will silently produce wrong canonicals.
const canonicalUrl = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const defaultImageUrl = Astro.site ? new URL(uhcwPng, Astro.site).href : uhcwPng;
const imageUrl = seo.image ?? defaultImageUrl;
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={imageUrl} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Canonical -->
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
