---
interface Props {
    title: string;
    text: string;
}

const { title, text } = Astro.props;
---

<div class="section-block">
    <h3 class="block-title">{title}</h3>
    <p class="block-text">{text}</p>
</div>

<style>
    .section-block {
        max-width: 400px;
    }

    .block-title {
        font-size: 2.125rem;
        font-weight: 400;
        line-height: 1.235;
        letter-spacing: 0.00735em;
        margin: 0 0 0.35em;
    }

    .block-text {
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.5;
        margin: 0 0 0.35em;
    }
</style>
